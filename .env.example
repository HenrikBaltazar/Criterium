# ==========================================
# CRITERIUM ELECTION PLATFORM - ENV EXAMPLE
# ==========================================
# Copie este arquivo para .env e preencha as variáveis de acordo com seu ambiente.

# Configurações do Banco de Dados PostgreSQL
POSTGRES_USER=criterium_user
POSTGRES_PASSWORD=sua_senha_segura_aqui
POSTGRES_DB=criterium_db
POSTGRES_PORT=5432

# URL de Conexão com o Banco de Dados (usado pelo Prisma)
DATABASE_URL=postgresql://criterium_user:sua_senha_segura_aqui@localhost:5432/criterium_db?schema=public

# Porta e Segredo JWT da API
PORT=4000
JWT_SECRET=seu_jwt_secret_super_seguro_aqui_2026

# Container Administrativo Separado (Admin DB Management)
ADMIN_PORT=8080
ADMIN_PASSWORD=sua_senha_admin_segura_aqui_2026

# Configurações de E-mail (Opcional - se vazio, a API usa entrega direta MX via Nodemailer)
# SMTP_HOST=smtp.seuprovedor.com
# SMTP_PORT=587
# SMTP_USER=seu_email@dominio.com
# SMTP_PASS=sua_senha_smtp
# EMAIL_FROM="Criterium <no-reply@criterium.app>"
